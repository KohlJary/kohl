#!/usr/bin/env bash
# kohl: a model playing Kohl, files included. https://github.com/KohlJary/kohl
#
#   kohl                 talk to it
#   kohl <command> [..]  start with /<command> (see `kohl --help`)
#   kohl why             the warnings, printed; no model involved
#
# The persona is read-only under $KOHL_SHARE. Your workspace (queue, ledger,
# STATUS) is ${XDG_DATA_HOME:-~/.local/share}/kohl, made by `gremlin init`
# on first run. It drafts; it never sends: no web tools, no MCP servers.
set -euo pipefail

KOHL_SHARE="${KOHL_SHARE:-/usr/share/kohl}"
WS="${KOHL_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/kohl}"
VERSION="@VERSION@"

banner() {
  printf 'kohl v%s: a model playing Kohl. What it says is not something Kohl said.\n' "$VERSION" >&2
}

commands() {
  local f name desc
  for f in "$KOHL_SHARE"/commands/*.md; do
    [[ -e "$f" ]] || continue
    name="$(basename "$f" .md)"
    desc="$(sed -n 's/^description: *//p' "$f" | head -1)"
    printf '  %-10s %s\n' "$name" "$desc"
  done
}

usage() {
  banner
  cat <<EOF

usage: kohl [command] [text...]

  kohl              talk to it
  kohl <command>    start the session with /<command> [text]

commands:
$(commands)

  kohl --version    print the version
  kohl --help       this

Workspace: $WS
EOF
}

why() {
  # The README's "Why you shouldn't do this" section, verbatim: up to the next "## ".
  local readme="$KOHL_SHARE/README.md"
  [[ -r "$readme" ]] || { echo "kohl: $readme is missing" >&2; exit 1; }
  local out
  out="$(awk '/^## Why you shouldn.t do this/{on=1; print; next} on && /^## /{exit} on{print}' "$readme")"
  [[ -n "$out" ]] || { echo "kohl: no \"Why you shouldn't do this\" section in $readme" >&2; exit 1; }
  printf '%s\n' "$out"
}

first_run() {
  [[ -f "$WS/gremlin.toml" ]] && return 0
  command -v gremlin >/dev/null || { echo "kohl: gremlin (gremlincore) isn't installed" >&2; exit 1; }
  local owner="${USER:-you}" pronouns="they/them" ans
  if [[ -t 0 ]]; then
    read -r -p "First run. What should it call you? [$owner] " ans || true
    owner="${ans:-$owner}"
    read -r -p "Your pronouns? [$pronouns] " ans || true
    pronouns="${ans:-$pronouns}"
  fi
  gremlin init "$WS" --owner "$owner" --pronouns "$pronouns" --agent RoboKohl --symbol "⊖" >/dev/null
  # init's CLAUDE.md and skill wake an agent from this home's own persona/,
  # which starts empty. Here the persona is Kohl's, read-only, and WAKE.md
  # (appended to the system prompt) is the wake. One wake, not two.
  rm -rf "$WS/.claude/skills/robokohl"
  cat > "$WS/CLAUDE.md" <<EOF
# kohl workspace

This is $owner's workspace for kohl: RoboKohl ⊖, a model playing Kohl.
The persona is Kohl's, read-only in \`$KOHL_SHARE/persona/\`; WAKE.md
(appended to your system prompt) is how you wake. \`persona/\` here is
$owner's, empty to start. The queue, the ledgers and STATUS.md here are
$owner's, not Kohl's.

You draft; $owner sends. Never read \`eval/\` or \`data/\`.
EOF
  echo "kohl: your workspace is $WS (queue, ledger, STATUS: yours, not Kohl's)" >&2
}

session() {
  command -v claude >/dev/null || { echo "kohl: claude (Claude Code) isn't installed" >&2; exit 1; }
  first_run
  cd "$WS"
  banner
  # ANTHROPIC_API_KEY is dropped so the session uses your Claude login, same as `gremlin talk`.
  # The first message goes before the options: --allowedTools and friends take
  # every word after them, and would swallow it.
  exec env -u ANTHROPIC_API_KEY claude "$@" \
    --append-system-prompt-file "$KOHL_SHARE/WAKE.md" \
    --plugin-dir "$KOHL_SHARE" \
    --add-dir "$KOHL_SHARE" \
    --strict-mcp-config \
    --tools Read Glob Grep Edit Write Bash \
    --allowedTools "Read($KOHL_SHARE/**)" "Read(./**)" "Glob" "Grep" \
                   "Bash(gremlin queue:*)" "Bash(gremlin ledger:*)" "Bash(gremlin wf:*)" \
                   "Bash(gremlin lessons:*)" "Bash(gremlin wake:*)" \
                   "Edit(./queue/**)" "Write(./queue/**)" \
    --disallowedTools WebFetch WebSearch \
                      "Edit($KOHL_SHARE/**)" "Write($KOHL_SHARE/**)"
}

case "${1:-}" in
  "") session ;;
  -h|--help|help) usage ;;
  -V|--version) echo "kohl $VERSION" ;;
  why) why ;;
  -*) echo "kohl: unknown option '$1' (kohl --help)" >&2; exit 2 ;;
  *)
    name="$1"; shift
    if [[ ! "$name" =~ ^[a-z][a-z0-9-]*$ || ! -f "$KOHL_SHARE/commands/$name.md" ]]; then
      echo "kohl: no command '$name'. Try: kohl --help" >&2
      exit 2
    fi
    session "/kohl:$name${*:+ $*}"
    ;;
esac
